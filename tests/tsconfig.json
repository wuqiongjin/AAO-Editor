{
  // 只为了让 tests 下的文件在编辑器 / 单文件 tsc 里能解析 `@/` 别名。
  // tsserver 按「最近祖先 tsconfig.json」选配置，根 tsconfig.json 是 files:[] 的
  // solution 风格、不收 tests，所以必须在 tests/ 里放一份。
  // 类型检查的权威配置仍是根上的 tsconfig.test.json（npm run test:types）。
  "extends": "../tsconfig.test.json",
  "include": ["**/*.ts", "**/*.tsx"]
}
