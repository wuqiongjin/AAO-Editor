{
  "name": "aao-editor",
  "private": true,
  "version": "0.1.0",
  "description": "Advanced Arrangement Organizer",
  "author": "AAO Editor",
  "main": "electron/main.cjs",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "dev:cloud": "DISABLE_HMR=1 vite",
    "setup": "bash scripts/setup.sh",
    "assets:sync": "node scripts/assets-sync.mjs",
    "assets:check": "node scripts/assets-sync.mjs --check",
    "build": "tsc -b && vite build",
    "build:release": "vite build --mode release",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build:release && electron-builder",
    "electron:dist": "npm run build:release && electron-builder --publish=never"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "async-exit-hook": "^2.0.1",
    "lucide-react": "^0.544.0",
    "mp4-muxer": "^5.2.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "webm-muxer": "^5.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^9.2.1",
    "electron": "^38.1.2",
    "electron-builder": "^24.13.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.aao.editor",
    "productName": "AAO Editor",
    "copyright": "Copyright © 2026 AAO Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/i18n/messages/**/*",
      "!node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": "dmg",
      "icon": "public/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    }
  }
}
